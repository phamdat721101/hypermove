# Local-only paid Dream Cycle smoke configuration. Copy to .env.mcp-smoke.
# That target file is ignored by git; do not place a real token or seed here
# until you are ready to submit one XRPL TESTNET RLUSD payment.

MCP_SMOKE_BASE_URL=https://your-host.example/api/mcp
MCP_SMOKE_HEALTH_URL=https://your-host.example/api/mcp/health
MCP_SMOKE_BEARER_TOKEN=replace-with-test-device-or-api-token
MCP_SMOKE_XRPL_SEED=replace-with-funded-xrpl-testnet-seed
MCP_SMOKE_RUN_PAID_DREAM=true
MCP_SMOKE_EXPECTED_DREAM_PAYMENT_CONTRACT=dream-quote-memo/v1
MAX_LIVE_SPEND_USD=0.10
