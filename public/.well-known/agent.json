{
  "name": "HyperMove",
  "description": "An MCP gateway for cross-chain web3 data (EVM + Stellar + XRPL), news + insight, agentic tools, and n-payment settlement.",
  "url": "https://hypermove.dev",
  "version": "2.0.0",
  "capabilities": {
    "tools": ["search", "data.call", "news.search", "codemode.news.insight", "insight.roadmap", "ideas.generate", "skillify", "payments.settle", "payments.status"],
    "transports": ["streamable-http"]
  },
  "endpoints": {
    "mcp": "https://hypermove.dev/api/mcp",
    "manifest": "https://hypermove.dev/.well-known/webmcp.json",
    "bundles": "https://hypermove.dev/bundles.json"
  },
  "license": "MIT",
  "source": "https://github.com/phamdat721721"
}
