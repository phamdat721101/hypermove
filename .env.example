# --- Live-agent demo --------------------------------------------------------
# mock  → deterministic SSE state machine, no API keys needed (default)
# real  → call Anthropic Claude Haiku; requires ANTHROPIC_API_KEY
LIVE_AGENT_MODE=mock
ANTHROPIC_API_KEY=
AGENT_DAILY_BUDGET_USD=5

# --- x402 paywall (server side) --------------------------------------------
# Address that receives USDC payments for /api/paid-endpoint
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_CHAIN=base-sepolia
PAYMENT_PRICE_MICRO_USDC=10000

# --- Supabase Postgres (registry storage) ----------------------------------
# Format: postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# Leave empty to no-op: /api/v1/register will accept submissions but not persist them.
DATABASE_URL=

# --- Feature flags (default off until ship-gate) ---------------------------
FEATURE_LIVE_AGENT=true
FEATURE_PORTAL=true
FEATURE_REGISTRY=false
FEATURE_DASHBOARD=false

# --- HyperMove v2.0 Platform Layer -----------------------------------------
# Master flag for the observability + sentinel + security stack. When false,
# every wrapper is an identity function (byte-identical v1.0 behavior).
FEATURE_HM_PLATFORM=false

# Optional Sentry-forward. When set (and FEATURE_HM_PLATFORM=true), captured
# events are dual-written to Sentry via lazy-imported @sentry/nextjs SDK.
# Enterprise buyers with existing Sentry setups enable this; nobody else needs it.
SENTRY_DSN=

# Cost caps enforced by Sentinel (per-agent per-day). Units: US-dollar float.
HM_COST_CAP_PER_AGENT_DAILY_USD=100
HM_COST_CAP_PER_AGENT_HOURLY_USD=20

# Circuit breaker (per-endpoint sliding window)
HM_CIRCUIT_ERROR_THRESHOLD=0.5
HM_CIRCUIT_COOLDOWN_MS=60000

# Optional ed25519 public key (hex) for event-signature verification on the
# /api/errors ingestion endpoint. Empty = signature check bypassed (dev-friendly).
HM_ED25519_PUBKEY=

# --- MCP host resolution (env-driven, no domain hardcoding) ---------------
# NEXT_PUBLIC_LLM_API_URL — base URL of the standalone LLM service that runs /scan.
#   Empty → frontend uses the in-Next.js /api/scan route (pure local dev).
NEXT_PUBLIC_LLM_API_URL=http://localhost:3001
# NEXT_PUBLIC_MCP_HOST_URL — base URL embedded in the returned MCP config (frontend).
#   Defaults to NEXT_PUBLIC_LLM_API_URL → falls back to window.location.origin.
#   Set this when the LLM service is reachable under a different public hostname.
NEXT_PUBLIC_MCP_HOST_URL=
# MCP_HOST_URL — server-side override on the LLM service for the hosted MCP base.
#   Use on production deploys (e.g. https://hypermove.duckdns.org). Ignored when the
#   request includes its own `host` field.
MCP_HOST_URL=
# MCP_HOST — server-side host for /api/scan and /api/download (Next.js routes).
MCP_HOST=localhost

# ─── HyperMove MCP Gateway v1.0 ─────────────────────────────────────────────
# Master flag. false → /api/mcp serves the legacy 2-tool surface (byte-identical
# rollback, and NEVER calls authenticate() — see note below). true → the
# cross-chain gateway (search + news + tiered payment).
#
# To require an auth key with no anonymous free tier, BOTH of the following
# must be true together — setting only FEATURE_MCP_AUTH_WORKOS is a silent
# no-op while the master flag is off, because the legacy surface it guards
# never checks auth at all:
#   FEATURE_HYPERMOVE_MCP_GATEWAY_V1=true
#   FEATURE_MCP_AUTH_WORKOS=true
FEATURE_HYPERMOVE_MCP_GATEWAY_V1=false
# Cascading sub-flags (only active when the master flag is also true):
FEATURE_MCP_AUTH_WORKOS=false        # auth gate (wallet signature or WorkOS OAuth)
FEATURE_MCP_RATE_LIMIT=false         # 10 free queries / rolling 24h
FEATURE_MCP_PAYWALL=false            # tiered x402/MPP + multi-chain routing
FEATURE_MCP_DATA_ADAPTERS_V1=false   # Moralis/Alchemy/QuickNode aggregation
FEATURE_MCP_VECTOR_SEARCH=false      # pgvector-style semantic backfill
FEATURE_MCP_NEWS_V1=false            # daily news + AI insight tools

# Payments are MOCK by default. In production, paid settlement is refused unless
# real rails (n-payment adapters) are wired AND this is explicitly set true.
MCP_PAYMENTS_LIVE=false

# Auth (wallet signature by default; WorkOS optional for email-only sign-in).
# HYPERMOVE_DEV_UNAUTHENTICATED bypasses BOTH — leave it unset/false whenever
# FEATURE_MCP_AUTH_WORKOS=true is meant to actually be enforced, including on
# localhost. Only set "true" for throwaway local debugging.
HYPERMOVE_MCP_ADMIN_TOKEN=           # internal ops bearer (SHA-256, timing-safe)
HYPERMOVE_DEV_UNAUTHENTICATED=false  # "true" + loopback host → dev bypass (skips wallet + WorkOS)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=                 # e.g. https://hypermove.xyz/api/mcp/callback

# Data provider keys. All optional — absent → deterministic MockProvider.
MORALIS_API_KEY=
ALCHEMY_API_KEY=
QUICKNODE_ENDPOINT_URL=

# Embeddings. Absent → deterministic MockEmbedder (zero-config).
EMBEDDINGS_URL=
EMBEDDINGS_DIM=1024

# News. "proj|rss-url,proj|rss-url". Absent → MockNewsProvider.
RSS_FEEDS=
# NEWS_LIVE=true → use curated Stellar/XRPL default feeds when RSS_FEEDS unset.
NEWS_LIVE=false
# LLM_API_URL — server-side insight synthesis endpoint (defaults to NEXT_PUBLIC_LLM_API_URL).
LLM_API_URL=

# ─── MCP Gateway v2.0 ───────────────────────────────────────────────────────
# All MCP feature flags default ON. Set any to "false" to roll that layer back.
# FEATURE_HYPERMOVE_MCP_GATEWAY_V1=false   # master off → legacy 2-tool endpoint
# FEATURE_MCP_AGENTIC_V1=false             # disable insight.roadmap/ideas.generate/skillify

# Stellar / XRPL data endpoints (keyless public defaults; override if desired).
STELLAR_HORIZON_URL=https://horizon.stellar.org
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
XRPL_RPC_URL=https://xrplcluster.com/

# Payment settlement over MCP (n-payment). Absent → mock rail (no paid sessions
# in production). Present → REAL on-chain USDC settlement via EIP-3009 x402.
PAY_TO_ADDRESS=                      # merchant payee (0x…) — enables real settlement
MCP_FACILITATOR_PRIVATE_KEY=         # facilitator wallet that broadcasts transferWithAuthorization
# RPC_URL_BASE_MAINNET=              # optional per-chain RPC override (defaults to public)

# ─── XRPL Builder Skills + Exa Research Pro (RLUSD/x402) ────────────────────
# The two XRPL skills (xrpl-search, xrpl-research-pro) are ALWAYS listed on
# /tools + over MCP — no visibility flag. Only the costly Exa deep-reasoning
# tier is opt-in.
FEATURE_XRPL_DEEP_REASONING=false    # gate the costly Exa deep-reasoning tier

# Exa (AI search engine) — powers xrpl-research-pro. Absent → plan-only result.
EXA_API_KEY=

# XRPL Pro settlement (RLUSD via T54 x402 facilitator).
XRPL_NETWORK=testnet                 # testnet | mainnet (challenge + facilitator)
XRPL_TREASURY_ADDRESS=               # r… classic address that receives the 5 RLUSD
# XRPL_FACILITATOR_URL=              # override the default T54 facilitator URL

# ─── Confidential MCP Tool Tier (Flare-oracle-only + XRPL-native settlement) ─
# Absent → confidential.attest returns an honest softEmpty (not_configured) —
# this is the EXPECTED default state, not an error. NEVER fabricates a quote.
#
# Production: sign up at Phala Cloud (docs.phala.com/phala-cloud/getting-started),
#   provision API access, and set:
#   TEE_ATTESTATION_PROVIDER_URL=https://cloud-api.phala.com/api/v1
#   TEE_ATTESTATION_API_KEY=<your Phala Cloud API key>
# This is a manual human step — HyperMove cannot provision a Phala Cloud
# account or API key on its own.
#
# Local dev: run the dstack TEE simulator (see docker/dstack-sim/docker-compose.yml
#   for setup — no official pre-built image exists, the compose file documents
#   the manual build-from-source steps) and point at it instead, e.g.:
#   TEE_ATTESTATION_PROVIDER_URL=http://localhost:8090
TEE_ATTESTATION_PROVIDER_URL=
TEE_ATTESTATION_API_KEY=

# ─── Flare TEE-Proxy Instruction Dispatch (flare.instruct.dispatch, 2026-07-20) ─
# Absent → dispatchInstruction() returns an honest `not_configured` fail — this
# is the EXPECTED default state until services/tee-extension is deployed to
# Coston2 (see its README.md for the real remaining blockers: Flare indexer-DB
# credentials + a public HTTPS tunnel — both require a human, not code).
#
#   TEE_EXTENSION_PROXY_URL=https://<your-tunnel-domain>        # ext-proxy's public URL
#   FLARE_INSTRUCTION_SENDER_ADDRESS=0x...                      # deployed InstructionSender.sol address
#   FLARE_INSTRUCT_SIGNER_KEY=0x...                              # funded Coston2 private key (hex, 0x-prefixed)
TEE_EXTENSION_PROXY_URL=
FLARE_INSTRUCTION_SENDER_ADDRESS=
FLARE_INSTRUCT_SIGNER_KEY=


