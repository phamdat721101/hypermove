# hypermove-fce-extension/.env.example
# Copy to .env and fill in before running `npm run dev`.

# ── HyperMove MCP gateway auth ──────────────────────────────────────────────
# Reuses the EXISTING admin-bypass bearer token already implemented in
# hypermove-app's src/lib/mcp/auth.ts (authenticate()'s "Layer 1 — admin
# token" branch). This is a documented tradeoff, not an oversight — see
# README.md "Known tradeoff: admin-token reuse" before deploying.
HYPERMOVE_MCP_ADMIN_TOKEN=

# Base URL of HyperMove's MCP endpoint.
HYPERMOVE_MCP_URL=https://hypermove.duckdns.org/api/mcp

# ── Flare TEE node internal APIs (loopback only — no auth, trusted boundary) ─
TEE_SIGN_URL=http://localhost:8888
TEE_EXTENSION_PORT=8889

# ── Optional ──────────────────────────────────────────────────────────────
# Flare chain id used in commitment digests (see chain-constants.ts's
# FLARE_CHAIN_IDS in hypermove-app for canonical values). Default: coston2.
FLARE_NETWORK=coston2
