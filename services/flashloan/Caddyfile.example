(hypermove_gateway) {
    reverse_proxy 127.0.0.1:3003 {
        header_up X-Flashloan-Client-IP {remote_host}
        transport http {
            response_header_timeout 75s
        }
    }
}

hypermove.duckdns.org {
    handle_path /llm/* {
        reverse_proxy 127.0.0.1:3001
    }
    import hypermove_gateway
}

mcp.overguild.com {
    route {
        handle_path /llm/* {
            reverse_proxy 127.0.0.1:3001
        }
        @credential_root {
            path /
            header Authorization *
        }
        handle @credential_root {
            rewrite * /api/mcp
            import hypermove_gateway
        }
        @admin_root {
            path /
            header X-Mcp-Admin-Token *
        }
        handle @admin_root {
            rewrite * /api/mcp
            import hypermove_gateway
        }
        handle / {
            rewrite * /api/mcp/flashloan
            import hypermove_gateway
        }
        handle {
            import hypermove_gateway
        }
    }
}
