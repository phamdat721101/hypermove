FLASHLOAN_WORKER_PORT=3012
FLASHLOAN_WORKER_TOKEN=${FLASHLOAN_WORKER_TOKEN}
FEATURE_MCP_FLASHLOAN_PUBLIC_STATELESS=false
# Separate server-only random integrity key, at least 32 bytes. Never an agent credential.
FLASHLOAN_PUBLIC_ARTIFACT_KEY=
DATABASE_URL=${DATABASE_URL}
FLASHLOAN_DATA_DIR=services/flashloan/data
# Configure HTTPS archival/capable endpoints. No signing keys are needed.
FLASHLOAN_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
FLASHLOAN_ARBITRUM_RPC_URL=https://arbitrum-one-rpc.publicnode.com
FLASHLOAN_BASE_RPC_URL=https://base-rpc.publicnode.com
FLASHLOAN_XRPL_RPC_URL=https://xrplcluster.com
# Optional Finance-only XRPL endpoint override for devnet positions and LoanPay.
FINANCE_XRPL_RPC_URL=
FEATURE_MCP_FINANCE_V1=false
FINANCE_XRPL_LOAN_PAY_V1=false
# JSON deployment registry entries must bind address, network, adapter,
# reviewed runtime code_hash, ABI version and protocol-defined V2 fee where needed.
FLASHLOAN_DEPLOYMENTS=[]

# New networks: discovery works independently; native research requires reviewed evidence.
FLASHLOAN_ROBINHOOD_RPC_URL=
FLASHLOAN_SUI_GRAPHQL_URL=
FLASHLOAN_SUI_GRPC_URL=
FLASHLOAN_SUI_CHAIN_IDENTIFIER=4btiuiMPvEENsttpZC7CZ53DruC3MAgfznDbASZ7DR6S
FLASHLOAN_SUI_DEPLOYMENTS=[]
# Evidence includes network, build_fingerprint, registry_hash, engine_version,
# verified_at/expires_at, source, and deterministic/local_e2e/live_quote/live_simulation checks.
FLASHLOAN_RESEARCH_EVIDENCE=[]

# Opt-in versioned candidate ledger and unequal allocation research (worker and gateway).
FLASHLOAN_CANDIDATE_RESEARCH_V1=false

# MCP v7 remains off until positive local-client and live/fork release gates pass.
FLASHLOAN_POOL_RESOLUTION_V1=false
FLASHLOAN_CANDIDATE_RESEARCH_V2=false
FLASHLOAN_INITIALIZATION_LOCATORS=[]

# Optional v8 public discovery; all default off. See docs/features/flashloan-mcp-v8.md.
FLASHLOAN_INVENTORY_V3=false
FLASHLOAN_MOVERS_V2=false
FLASHLOAN_WATCHLIST_V1=false
FLASHLOAN_REGISTRY_V1=false
# Server-reviewed JSON; never execution authorization. Empty registry is honest/unconfigured.
FLASHLOAN_DISCOVERY_REGISTRY={}
