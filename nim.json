{
  "harness": {
    "cache": {
      "provider": "auto",
      "strategy": "prefix",
      "ttl": "1h",
      "minTokens": 1024,
      "roi": true,
      "breakEvenReads": 2
    },
    "enforcer": {
      "maxHeals": 2,
      "mode": "strict"
    },
    "monitor": {
      "exporters": ["file"],
      "traceFile": ".nim/traces.jsonl",
      "tokenAccounting": true
    },
    "memory": {
      "verifyCache": true,
      "priors": true,
      "ttlMs": 86400000,
      "store": ".nim/mcp-verify-memory.jsonl"
    },
    "lessons": {
      "store": ".nim/mcp-lessons.jsonl",
      "ttlMs": 2592000000
    },
    "logCompact": {
      "maxLines": 40,
      "strategy": "errors-only",
      "escalateOnEmpty": true
    }
  },
  "workrule": {
    "logFile": ".nim/agent-support-log.md"
  }
}
